# LLM provider (OpenAI-compatible). Tested with OpenAI, DeepSeek, Volcano Ark.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# Mock database location (relative to project root). Optional.
DB_PATH=data/ecommerce.db

# PostgreSQL CRM demo. Optional — only needed for `crm-ask` / `crm-seed`.
# CRM_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/crm

# MySQL library demo. Optional — only needed for `mysql-ask` / `mysql-seed`.
# MYSQL_DATABASE_URL=mysql://root:root@127.0.0.1:3307/library
