{
  "name": "datapulse-desktop",
  "version": "0.1.0",
  "description": "DataPulse desktop console (Electron + React) for the ask feature",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "VITE_DEV_SERVER_URL=http://localhost:5174 electron .",
    "dev:all": "./dev.sh",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^37.10.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
